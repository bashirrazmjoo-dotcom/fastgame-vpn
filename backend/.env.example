# Copy to .env and fill in. Never commit the real file.

# Master secret (>= 32 chars). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it invalidates device tokens, admin sessions and stored server credentials.
FG_SECRET_KEY=

FG_ENV=production
FG_DATABASE_URL=postgresql+psycopg://fastgame:CHANGE_ME@db:5432/fastgame

# First admin, created automatically only while no admin exists. Remove afterwards.
FG_ADMIN_BOOTSTRAP_USERNAME=
FG_ADMIN_BOOTSTRAP_PASSWORD=

# Admin panel origin(s) allowed by CORS, comma separated.
FG_CORS_ORIGINS=https://admin.example.com

FG_SUPPORT_TELEGRAM_USERNAME=fastgamevpn_bot
# Required by Google Play for VPN apps (privacy policy must be a public URL).
FG_PRIVACY_POLICY_URL=
FG_TERMS_URL=

# Free tier (defaults: 120 minutes per 24h cycle)
# FG_FREE_QUOTA_SECONDS=7200
# FG_CYCLE_SECONDS=86400
